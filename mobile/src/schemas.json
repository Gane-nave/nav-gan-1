{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gane.navigation/schemas/v1.0.0",
  "title": "G.A.N.E Navigation Schemas v1.0.0",
  "description": "Formal contracts for G.A.N.E navigation data interchange. SemVer: breaking changes bump major.",
  "definitions": {
    "LLA": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "alt": {"type": "number", "minimum": -500, "maximum": 10000}
      }
    },
    "ConstellationId": {
      "type": "string",
      "enum": ["GPS", "GLONASS", "Galileo", "BeiDou", "QZSS", "NavIC", "SBAS"]
    },
    "NavMode": {
      "type": "string",
      "enum": ["FULL", "DEGRADED", "DR_ONLY", "LOST", "RECOVERY"]
    },
    "SystemPhase": {
      "type": "string",
      "enum": ["HEALTHY", "CAUTIOUS", "DEGRADED", "RESTRICTED", "FAIL_SAFE"]
    },
    "EnvClass": {
      "type": "string",
      "enum": ["OPEN", "URBAN", "CANYON", "TUNNEL", "INDOOR", "UNKNOWN"]
    },
    "RawMeasurement": {
      "type": "object",
      "required": ["svid", "constellation", "cn0", "usedInFix", "t"],
      "properties": {
        "svid": {"type": "integer", "minimum": 1, "maximum": 250},
        "constellation": {"$ref": "#/definitions/ConstellationId"},
        "pseudorange": {"type": "number"},
        "carrierPhase": {"type": "number"},
        "doppler": {"type": "number"},
        "cn0": {"type": "number", "minimum": 0, "maximum": 60},
        "elevation": {"type": "number", "minimum": 0, "maximum": 90},
        "azimuth": {"type": "number", "minimum": 0, "maximum": 360},
        "carrierFreq": {"type": "number"},
        "usedInFix": {"type": "boolean"},
        "hasEphemeris": {"type": "boolean"},
        "t": {"type": "integer", "description": "Unix timestamp in ms"}
      }
    },
    "IntegrityEvent": {
      "type": "object",
      "required": ["type", "severity", "t"],
      "properties": {
        "type": {"type": "string", "enum": ["JUMP", "CN0_FLOOR", "SINGLE_CONSTELLATION", "RESIDUAL_OUTLIER", "SV_EXCLUDED", "SV_REVALIDATED", "IMU_DIVERGENCE", "MAP_MISMATCH"]},
        "severity": {"type": "string", "enum": ["INFO", "WARN", "CRIT"]},
        "data": {"type": "object"},
        "t": {"type": "integer"}
      }
    },
    "NavTraceEntry": {
      "type": "object",
      "required": ["t", "mode", "numSats", "confidence", "env"],
      "properties": {
        "t": {"type": "integer"},
        "mode": {"$ref": "#/definitions/NavMode"},
        "numSats": {"type": "integer", "minimum": 0},
        "pdop": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "trustSum": {"type": "number", "minimum": 0},
        "integrity": {"type": "array", "items": {"$ref": "#/definitions/IntegrityEvent"}},
        "env": {"$ref": "#/definitions/EnvClass"}
      }
    },
    "MissionExport": {
      "type": "object",
      "required": ["version", "entries", "exportedAt"],
      "properties": {
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "exportedAt": {"type": "integer"},
        "sessionId": {"type": "string"},
        "device": {
          "type": "object",
          "properties": {
            "platform": {"type": "string"},
            "userAgent": {"type": "string"},
            "capabilities": {"type": "object"}
          }
        },
        "entries": {"type": "array", "items": {"$ref": "#/definitions/NavTraceEntry"}},
        "summary": {
          "type": "object",
          "properties": {
            "durationSec": {"type": "number"},
            "startLLA": {"$ref": "#/definitions/LLA"},
            "endLLA": {"$ref": "#/definitions/LLA"},
            "modeTransitions": {"type": "integer"},
            "peakSpoofScore": {"type": "number", "minimum": 0, "maximum": 1},
            "availability": {"type": "number", "minimum": 0, "maximum": 1},
            "continuity": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "DecisionRecord": {
      "type": "object",
      "required": ["id", "type", "chosen", "confidence", "t"],
      "properties": {
        "id": {"type": "string"},
        "type": {"type": "string", "enum": ["ROUTE", "MODE_CHANGE", "PROVIDER_SWITCH", "EMERGENCY", "USER_ACTION"]},
        "chosen": {"type": "object"},
        "alternatives": {"type": "array"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "factors": {"type": "object", "additionalProperties": {"type": "number"}},
        "t": {"type": "integer"},
        "outcome": {"type": "object"},
        "correctnessScore": {"type": "number", "minimum": 0, "maximum": 1},
        "outcomeT": {"type": "integer"}
      }
    },
    "EvidenceBundle": {
      "description": "Forensic-grade bundle exportable for legal/regulatory audit",
      "type": "object",
      "required": ["version", "sessionId", "createdAt", "mission", "decisions", "contradictions", "verdicts"],
      "properties": {
        "version": {"const": "1.0.0"},
        "sessionId": {"type": "string"},
        "createdAt": {"type": "integer"},
        "mission": {"$ref": "#/definitions/MissionExport"},
        "decisions": {"type": "array", "items": {"$ref": "#/definitions/DecisionRecord"}},
        "contradictions": {"type": "array"},
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "t": {"type": "integer"},
              "phase": {"$ref": "#/definitions/SystemPhase"},
              "confidence": {"type": "number"},
              "statement": {"type": "string"}
            }
          }
        },
        "auditLog": {"type": "array"},
        "signature": {
          "type": "object",
          "properties": {
            "algorithm": {"type": "string"},
            "hash": {"type": "string"}
          }
        }
      }
    },
    "IncomingMeasurement": {
      "description": "Payload shape for external systems sending raw GNSS to G.A.N.E",
      "type": "object",
      "required": ["source", "measurements", "t"],
      "properties": {
        "source": {"type": "string", "enum": ["android-native", "web-geolocation", "replay", "external-receiver"]},
        "measurements": {"type": "array", "items": {"$ref": "#/definitions/RawMeasurement"}},
        "t": {"type": "integer"}
      }
    }
  },
  "type": "object",
  "properties": {
    "missionExport": {"$ref": "#/definitions/MissionExport"},
    "decisionRecord": {"$ref": "#/definitions/DecisionRecord"},
    "evidenceBundle": {"$ref": "#/definitions/EvidenceBundle"},
    "incomingMeasurement": {"$ref": "#/definitions/IncomingMeasurement"}
  }
}
