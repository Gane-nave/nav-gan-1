---
title: "G.A.N.E — System Dependency Graph"
---
graph BT
    subgraph "Infrastructure (No Dependencies)"
        gnss["🛰️ GNSS Receiver<br/>Criticality: CRITICAL"]
        imu["📐 IMU Sensors<br/>Criticality: HIGH"]
        network["🌐 Network<br/>Criticality: HIGH"]
        database["💾 Database (TiDB)<br/>Criticality: CRITICAL"]
    end

    subgraph "Core Engines"
        multiConst["🛰️ Multi-Constellation<br/>GPS+Galileo+GLONASS+BeiDou"]
        pdr["🚶 PDR Engine<br/>Dead Reckoning"]
        eskf["📍 ESKF Engine<br/>Criticality: CRITICAL<br/>15-state Kalman Filter"]
        mapData["🗺️ Map Tile Service<br/>Criticality: HIGH"]
    end

    subgraph "Derived Services"
        mapRenderer["🎨 Map Renderer<br/>Criticality: HIGH<br/>WebGL + Canvas 2D"]
        routeGraph["🛣️ Route Graph<br/>Criticality: HIGH<br/>A* / Dijkstra"]
        api["🔀 API Gateway<br/>Criticality: CRITICAL"]
    end

    subgraph "Application Services"
        navigation["🧭 Navigation Manager<br/>Criticality: CRITICAL"]
        reroute["🔄 Reroute Engine"]
        incident["🚨 Incident Engine"]
        crowd["👥 Crowd Intelligence"]
        analytics["📈 Analytics"]
        liveShare["📍 Live Sharing"]
        telemetry["📊 Telemetry"]
        admin["⚙️ Admin Panel"]
    end

    gnss --> multiConst
    gnss --> eskf
    imu --> eskf
    imu --> pdr
    network --> mapData
    network --> api

    multiConst --> eskf
    mapData --> eskf
    mapData --> mapRenderer
    mapData --> routeGraph
    database --> api

    eskf --> navigation
    eskf --> routeGraph
    routeGraph --> navigation
    routeGraph --> reroute
    mapRenderer --> navigation

    api --> incident
    api --> crowd
    api --> analytics
    api --> liveShare
    api --> telemetry
    api --> admin

